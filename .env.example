# --- Secrets / IDs (required) ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application (client) ID, used to register slash commands
APP_ID=

# The single guild (server) this bot serves. Guild-scoped commands update instantly.
GUILD_ID=

# --- Runtime config (optional, has sane defaults) ---
# Where the SQLite database file lives. Relative to the project root.
DB_PATH=./data/cheki.db

# Timezone used when interpreting admin-entered drop times.
# Bangkok is always UTC+7; time.js computes UTC+7 explicitly, so this is mostly
# for log timestamps. Leave as-is unless you know what you're doing.
TZ=Asia/Bangkok

# Optional bootstrap values. These are NOT required; the source of truth for
# operational config is set at runtime with /cheki config and stored in SQLite.
# ADMIN_ROLE_ID=
# PROMPTPAY_ID=

# --- Web dashboard (optional, see docs/DASHBOARD.md) ---
# Leave ADMIN_PORT unset to disable the dashboard entirely. When set, an admin
# HTTP server starts IN-PROCESS. Keep ADMIN_HOST=127.0.0.1 and expose it only
# through Cloudflare Tunnel + Cloudflare Access (never open the port publicly).
# ADMIN_PORT=8787
# ADMIN_HOST=127.0.0.1
# Comma-separated emails allowed by Cloudflare Access (empty = allow any email
# that already passed Access). e.g. you@gmail.com
# ADMIN_ALLOWED_EMAILS=
# Shared token for LOCAL testing without Cloudflare (send as X-Admin-Token header
# or ?token= in the URL). Do NOT rely on this in production.
# ADMIN_TOKEN=

# --- Cloudflare Named Tunnel (optional — STABLE URL, needs a domain) ---
# Set this to switch scripts/start-tunnel.sh from a random Quick-Tunnel URL to a
# fixed one. Create the tunnel + public hostname in the Cloudflare Zero Trust
# dashboard (Networks -> Tunnels), then paste the tunnel token here.
# CF_TUNNEL_TOKEN=
# The hostname you mapped to it (so the script can print the full link).
# CF_TUNNEL_HOSTNAME=cheki-admin.yourdomain.com

# --- Supabase order backup (optional, see docs/SUPABASE.md) ---
# When set, every finalized order is mirrored to a Supabase table (SQLite stays
# the source of truth; the bot never depends on Supabase to run). Leave unset to
# disable. Use the service_role key (server-side only — keep it secret).
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=
# SUPABASE_TABLE=cheki_orders
